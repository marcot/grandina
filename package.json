{
  "name": "grandina",
  "version": "0.1.0",
  "description": "Hail prediction from Italian Civil Protection radar data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "grandina": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "node --import tsx src/cli.ts",
    "serve": "node dist/server.js",
    "dev:web": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "geotiff": "^2.1.3",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/proj4": "^2.5.6",
    "leaflet": "^1.9.4",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
